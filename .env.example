# Safe local-development default. Changing this to 0.0.0.0 exposes an
# unauthenticated control API; do so only as an explicit opt-in on an isolated,
# firewall-restricted management network.
TREX_WEBUI_API_HOST=127.0.0.1
TREX_WEBUI_API_PORT=8080

# Real TRex control-plane endpoint. Loopback is the safe default.
# A remote target is an explicit external-supervisor deployment: set the host
# deliberately, keep TREX_WEBUI_DAEMON_SUPERVISOR=external, restrict
# 8090/4500/4501/4507 to the WebUI host, and provide authentication/persistence
# outside this application. TRex WebUI has no built-in authentication or RBAC.
TREX_WEBUI_TREX_HOST=127.0.0.1
TREX_WEBUI_TREX_SYNC_PORT=4501
TREX_WEBUI_TREX_ASYNC_PORT=4500
TREX_WEBUI_TREX_SCAPY_PORT=4507
TREX_WEBUI_TREX_CLIENT_NAME=Client1
TREX_WEBUI_TREX_TIMEOUT_SECONDS=3
TREX_WEBUI_TREX_DAEMON_PORT=8090
# "systemd" is forced by the local managed installer. Development and explicitly
# operator-managed local/remote daemon deployments use "external".
TREX_WEBUI_DAEMON_SUPERVISOR=external

# Local TRex installation paths on the backend host
TREX_WEBUI_TREX_SCRIPTS_DIR=/opt/trex-core/scripts
TREX_WEBUI_TREX_DAEMON_BIN=/opt/trex-core/scripts/trex_daemon_server
TREX_WEBUI_TREX_CONFIG_PATH=/etc/trex_cfg.yaml
TREX_WEBUI_TREX_DAEMON_LOG=/var/log/trex/trex_daemon_server.log

# Colon-separated allowlist for profile load/start workflows.
# Python profiles can execute code, so keep this narrow.
TREX_WEBUI_PROFILE_ROOTS=/opt/trex-core/scripts/stl:/opt/trex-webui/profiles

# Safety
TREX_WEBUI_COMMAND_TIMEOUT_SECONDS=20
TREX_WEBUI_REQUIRE_CONFIRMATION=1
